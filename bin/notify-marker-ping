#!/bin/bash

# notify-marker-ping
# Pings the user on request (the ping skill runs it).
# Writes a PING marker for the watcher to turn into a desktop notification.
#
# Unlike the Stop/Notification hooks, this IGNORES pause state: pausing a
# session silences routine "agent done" noise, not deliberate requests for the
# user's attention. It still requires CC_NOTIFY_MARKER_DIR (opt-in).
#
# Usage: notify-marker-ping [message...]
#        notify-marker-ping --max   (print the message length limit)
#
# Marker contents: line 1 = session label, line 2 = optional message. A message
# over CC_NOTIFY_MARKER_PING_MAX characters (default 255) is rejected, so a
# notification or a spoken ping stays short.
#
# After writing, waits up to CC_NOTIFY_MARKER_PING_WAIT seconds (default 2) for
# the watcher to consume the marker, so the caller knows whether it was seen:
#   exit 0 - delivered (watcher picked it up)
#   exit 1 - disabled / could not write
#   exit 2 - message too long; nothing sent
#   exit 3 - not picked up (watcher likely not running); marker is removed

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

# Fall back to the default when the limit is not a positive integer.
max="${CC_NOTIFY_MARKER_PING_MAX:-}"
[[ "$max" =~ ^[1-9][0-9]*$ ]] || max=255

# Before the enabled check: the skill reads this as it loads, and a failure
# there aborts the skill.
if [ "$#" -eq 1 ] && [ "$1" = --max ]; then
    echo "$max"
    exit 0
fi

dir="$(notify_marker_dir)" || {
    echo "notify-marker-ping: disabled (CC_NOTIFY_MARKER_DIR not set)" >&2
    exit 1
}

sid="${CLAUDE_CODE_SESSION_ID:-}"
label="$(notify_marker_session_name)"
label="${label:-$sid}"
message="$*"
if [ "${#message}" -gt "$max" ]; then
    echo "notify-marker-ping: message is ${#message} characters, over the limit of $max; not sent" >&2
    exit 2
fi

suffix="$$.$(date +%s%N 2>/dev/null || echo "$RANDOM")"
mkdir -p "$dir" 2>/dev/null || exit 1
marker="$dir/PING.${suffix}"
if [ -n "$message" ]; then
    printf '%s\n%s' "$label" "$message" > "$marker" || exit 1
else
    printf '%s' "$label" > "$marker" || exit 1
fi

# Poll in 0.1s steps until the watcher removes the marker or we time out.
wait="${CC_NOTIFY_MARKER_PING_WAIT:-2}"
steps=$(awk -v w="$wait" 'BEGIN { printf "%d", w * 10 }')
for ((i = 0; i < steps; i++)); do
    [ -e "$marker" ] || break
    sleep 0.1
done

if [ -e "$marker" ]; then
    rm -f "$marker"
    echo "notify-marker: ping NOT picked up (watcher not running?) - tell the user in your reply instead"
    exit 3
fi
echo "notify-marker: ping delivered"
